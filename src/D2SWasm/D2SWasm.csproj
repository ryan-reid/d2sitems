<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <BlazorEnableCompression>false</BlazorEnableCompression>
    <AssemblyName>D2SWasm</AssemblyName>
    <RootNamespace>D2SWasm</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="D2SSharp" Version="0.0.21" />
  </ItemGroup>

  <!-- Read BK resources directly from the submodule; never mirror them in this repo. -->
  <PropertyGroup>
    <BKDataRoot>$(MSBuildProjectDirectory)/../../mods/BKDiablo/bkdiablo.mpq/data</BKDataRoot>
  </PropertyGroup>
  <Target Name="RequireBKSubmodule" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(BKDataRoot)/global/excel/uniqueitems.txt')"
           Text="BKDiablo submodule is missing. Run git submodule update --init --recursive." />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="EmbeddedData/baselines/*" LogicalName="baselines/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../propertygroups.txt" LogicalName="propertygroups.txt" />
    <EmbeddedResource Include="$(BKDataRoot)/global/excel/*.txt" LogicalName="excel/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(BKDataRoot)/local/lng/strings/*.json" LogicalName="strings/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(BKDataRoot)/global/ui/layouts/bankexpansionlayouthd.json" LogicalName="ui/layouts/bankexpansionlayouthd.json" />
  </ItemGroup>

  <!-- Link common engine C# files -->
  <ItemGroup>
    <Compile Include="..\..\MulePackingPlanner.cs" Link="MulePackingPlanner.cs" />
    <Compile Include="..\..\SaveInspectorEngine.cs" Link="SaveInspectorEngine.cs" />
    <Compile Include="..\..\MuleGenerator.cs" Link="MuleGenerator.cs" />
    <Compile Include="..\..\QuestManager.cs" Link="QuestManager.cs" />
    <Compile Include="..\..\InventoryGridModel.cs" Link="InventoryGridModel.cs" />
    <Compile Include="..\..\ItemTransferManager.cs" Link="ItemTransferManager.cs" />
    <Compile Include="..\..\SaveBackup.cs" Link="SaveBackup.cs" />
    <Compile Include="..\..\GameDataTables.cs" Link="GameDataTables.cs" />
    <Compile Include="..\..\PropertyRangeCatalog.cs" Link="PropertyRangeCatalog.cs" />
    <Compile Include="..\..\SaveFileTransaction.cs" Link="SaveFileTransaction.cs" />
    <Compile Include="..\..\StackEditorManager.cs" Link="StackEditorManager.cs" />
    <Compile Include="..\..\NetNewItemManager.cs" Link="NetNewItemManager.cs" />
  </ItemGroup>

</Project>
