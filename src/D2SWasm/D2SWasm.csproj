<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <BlazorEnableCompression>false</BlazorEnableCompression>
    <AssemblyName>D2SWasm</AssemblyName>
    <RootNamespace>D2SWasm</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="D2SSharp" Version="0.0.21" />
  </ItemGroup>

  <!-- Embed data files (excel, strings, baselines) as resources -->
  <ItemGroup>
    <EmbeddedResource Include="EmbeddedData\**\*" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Link common engine C# files -->
  <ItemGroup>
    <Compile Include="..\..\MulePackingPlanner.cs" Link="MulePackingPlanner.cs" />
    <Compile Include="..\..\SaveInspectorEngine.cs" Link="SaveInspectorEngine.cs" />
    <Compile Include="..\..\MuleGenerator.cs" Link="MuleGenerator.cs" />
    <Compile Include="..\..\QuestManager.cs" Link="QuestManager.cs" />
    <Compile Include="..\..\InventoryGridModel.cs" Link="InventoryGridModel.cs" />
    <Compile Include="..\..\ItemTransferManager.cs" Link="ItemTransferManager.cs" />
    <Compile Include="..\..\SaveBackup.cs" Link="SaveBackup.cs" />
    <Compile Include="..\..\GameDataTables.cs" Link="GameDataTables.cs" />
    <Compile Include="..\..\PropertyRangeCatalog.cs" Link="PropertyRangeCatalog.cs" />
    <Compile Include="..\..\SaveFileTransaction.cs" Link="SaveFileTransaction.cs" />
    <Compile Include="..\..\StackEditorManager.cs" Link="StackEditorManager.cs" />
    <Compile Include="..\..\NetNewItemManager.cs" Link="NetNewItemManager.cs" />
  </ItemGroup>

</Project>
